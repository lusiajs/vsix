{
  "name": "lusia-vscode",
  "displayName": "Lusia",
  "description": "Make .lusia files easy to write: colors, autocomplete, errors, format.",
  "version": "0.2.0",
  "publisher": "lusia",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusiajs/vsix.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lusia"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/extension.ts --target node --format cjs --minify --external vscode --external typescript --external lusiajs --outfile dist/extension.js",
    "package": "bun run build && bunx @vscode/vsce package"
  },
  "devDependencies": {
    "lusiajs": "^0.2.0-beta",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "html-validate": "^11.21.1",
    "prettier": "^3.10.1",
    "sass-graph": "^4.0.1",
    "scss-symbols-parser": "^2.0.1",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "lusia": "html"
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "lusiaBranch:lusia": {
            "bold": true
          },
          "lusiaLoop:lusia": {
            "bold": true
          },
          "lusiaSlot:lusia": {
            "bold": true
          },
          "lusiaHint:lusia": {
            "bold": true
          }
        }
      }
    },
    "languages": [
      {
        "id": "lusia",
        "aliases": [
          "Lusia",
          "lusia"
        ],
        "extensions": [
          ".lusia"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lusia.svg",
          "dark": "./icons/lusia.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "lusia",
        "scopeName": "source.lusia",
        "path": "./syntaxes/lusia.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.html": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "lusia",
        "path": "./snippets/lusia.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lusia",
        "semanticHighlighting": true,
        "scopes": {
          "keyword": [
            "keyword.control.flow.lusia"
          ],
          "decorator": [
            "keyword.other.bind.lusia",
            "keyword.other.animate.lusia"
          ],
          "event": [
            "keyword.other.event.lusia"
          ],
          "parameter": [
            "entity.other.attribute-name.html"
          ],
          "class": [
            "entity.name.type.class.lusia"
          ],
          "enumMember": [
            "variable.other.enummember"
          ],
          "lusiaBranch": [
            "keyword.control.conditional.lusia"
          ],
          "lusiaLoop": [
            "keyword.control.loop.lusia"
          ],
          "lusiaSlot": [
            "storage.type.lusia"
          ],
          "lusiaHint": [
            "storage.modifier.lusia"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "lusia.reloadHost",
        "title": "Lusia: Reload language host"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "lusiaBranch",
        "superType": "keyword",
        "description": "Lusia branch tag: IF, ELSEIF, ELSE"
      },
      {
        "id": "lusiaLoop",
        "superType": "keyword",
        "description": "Lusia loop tag: EACH, FOR"
      },
      {
        "id": "lusiaSlot",
        "superType": "keyword",
        "description": "Lusia slot tag: CONTENT, HTML, FALLBACK"
      },
      {
        "id": "lusiaHint",
        "superType": "keyword",
        "description": "Lusia render hint tag: NO_LAZY, NO_SSR"
      }
    ]
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "lusia",
    "bun",
    "typescript",
    "scss",
    "html",
    "single-file",
    "component",
    "framework",
    "ui",
    "syntax highlighting",
    "autocomplete",
    "intellisense",
    "formatter",
    "snippets"
  ]
}
