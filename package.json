{
  "name": "lusia-vscode",
  "displayName": "Lusia",
  "description": "Syntax, completion, hover, diagnostics and navigation for Lusia .lusia components.",
  "version": "0.2.0",
  "publisher": "lusia",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lusia"
  ],
  "scripts": {
    "build": "bun build src/extension.ts --target node --format cjs --external vscode --external typescript --outfile dist/extension.js",
    "package": "bun run build && bunx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "html-validate": "^11.21.1",
    "prettier": "^3.10.1",
    "sass-graph": "^4.0.1",
    "scss-symbols-parser": "^2.0.1",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "lusia": "html"
      }
    },
    "languages": [
      {
        "id": "lusia",
        "aliases": [
          "Lusia",
          "lusia"
        ],
        "extensions": [
          ".lusia"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lusia",
        "scopeName": "source.lusia",
        "path": "./syntaxes/lusia.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.html": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "lusia",
        "path": "./snippets/lusia.json"
      }
    ]
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
